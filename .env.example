# 浏览器公开配置
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_APP_ENV=local
VITE_SENTRY_DSN=

# 服务端配置；禁止使用 VITE_ 前缀
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
GEMINI_API_KEY=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# 逗号分隔，当前版本放第一位，例如 v2:secret,v1:old-secret
ANON_SESSION_KEYS=
ACTOR_HASH_SECRET=

# 32 字节随机值的 Base64，用于加密 24 小时幂等响应缓存
AI_CACHE_ENCRYPTION_KEY=

# Vercel Cron 调用内部保留/删除任务的 Bearer 密钥
CRON_SECRET=

# 逗号分隔的完整 origin，例如 http://localhost:5173,https://example.com
APP_ORIGINS=

# 可选：部署时由监控发布流程使用；不得暴露为 VITE_ 变量
SENTRY_AUTH_TOKEN=
