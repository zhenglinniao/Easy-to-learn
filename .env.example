# 浏览器公开配置
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_APP_ENV=local
VITE_SENTRY_DSN=

# 服务端配置；禁止使用 VITE_ 前缀
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# AI Provider 按顺序尝试；标识仅允许字母、数字和下划线
AI_PROVIDERS=primary,backup
# 必须是 skills/canvas-tutor-planner/references/prompt-registry.json 中已注册的版本
AI_PROMPT_VERSION=v3

# 主 Provider：OpenAI-compatible，适用于 OpenAI、DeepSeek、通义千问、
# Moonshot、OpenRouter、Groq 或兼容 Chat Completions / Responses API 的本地服务
AI_PROVIDER_PRIMARY_TYPE=openai-compatible
AI_PROVIDER_PRIMARY_BASE_URL=
AI_PROVIDER_PRIMARY_API_KEY=
AI_PROVIDER_PRIMARY_MODEL=
# json_schema | json_object | prompt；按供应商能力选择
AI_PROVIDER_PRIMARY_RESPONSE_FORMAT=json_schema
# chat_completions | responses；DeepSeek 图文结构化输出推荐 responses
AI_PROVIDER_PRIMARY_WIRE_API=chat_completions
# 可选：none | low | high | max；仅在供应商支持时配置
AI_PROVIDER_PRIMARY_REASONING_EFFORT=
AI_PROVIDER_PRIMARY_TIMEOUT_MS=12000

# 后备 Provider 示例：Gemini。不需要后备时从 AI_PROVIDERS 删除 backup
AI_PROVIDER_BACKUP_TYPE=gemini
AI_PROVIDER_BACKUP_API_KEY=
AI_PROVIDER_BACKUP_MODEL=gemini-3.6-flash
AI_PROVIDER_BACKUP_TIMEOUT_MS=12000

# 旧版 Gemini 部署兼容变量；使用 AI_PROVIDERS 后无需配置
GEMINI_API_KEY=
AI_MODEL=
AI_TIMEOUT_MS=25000

# 逗号分隔，当前版本放第一位，例如 v2:secret,v1:old-secret
ANON_SESSION_KEYS=
ACTOR_HASH_SECRET=

# 32 字节随机值的 Base64，用于加密 24 小时幂等响应缓存
AI_CACHE_ENCRYPTION_KEY=

# Vercel Cron 调用内部保留/删除任务的 Bearer 密钥
CRON_SECRET=

# 逗号分隔的完整 origin，例如 http://localhost:5173,https://example.com
APP_ORIGINS=

# 可选：部署时由监控发布流程使用；不得暴露为 VITE_ 变量
SENTRY_AUTH_TOKEN=
